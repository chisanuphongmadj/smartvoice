# ── STT: Whisper ──────────────────────────────────────────
# Options: biodatlab/distill-whisper-th-large-v3 (default, Thai distilled large-v3)
#          large-v3 (generic multilingual, faster-whisper backend)
#          large-v3-turbo (fastest, slightly less accurate)
WHISPER_MODEL=biodatlab/distill-whisper-th-large-v3
# Backend: auto / transformers / faster-whisper
# Recommended for biodatlab/distill-whisper-th-large-v3: transformers
# Use faster-whisper mainly with native CT2 / standard models such as large-v3
WHISPER_BACKEND=transformers
# Device: auto / cuda / cpu
WHISPER_DEVICE=auto
# Compute type: auto / float16 / int8
WHISPER_COMPUTE=auto
# Beam size for decoding
WHISPER_BEAM_SIZE=5
# Keep chunk decoding independent to reduce repetition/context bleed on long calls
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
# Slightly more patient decoding for quality-first mode
WHISPER_PATIENCE=1.2
# Keep VAD off here; downstream diarization already segments turns and this avoids dropped speech
WHISPER_VAD_FILTER=false
# Extra domain terms, comma-separated
WHISPER_HOTWORDS=Restonic,Trade-in,หาดใหญ่,สุราษฎร์ธานี,อุทกภัย,ประกันโครงสร้าง,ภาคใต้,ทางห้าง,จัดโปร,แห้งแค่ข้างนอก,มิน่า
DENOISE_ENABLED=true
# Slightly gentler denoise helps preserve Thai consonants on noisy phone audio
DENOISE_PROP_DECREASE=0.35

# Set to true to skip STT and use built-in mock transcripts
MOCK_STT=false

# ── Speaker Diarization: pyannote/speaker-diarization-3.1 ─
# Get token at https://hf.co/settings/tokens (need model access)
HF_TOKEN=

# ── LLM: Ollama (local) ──────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=scb10x/llama3.1-typhoon2-8b-instruct

# ── Database ──────────────────────────────────────────────
DB_PATH=data/smartvoice.db

# ── Case Auto-Assignment ─────────────────────────────────
# If a new call arrives from a customer who has an open case with a sibling
# call within this many hours, auto-attach WITHOUT asking the LLM.
# Handles "customer called back / dropped-call follow-up" pattern.
# Set to 0 to disable and always rely on LLM matching.
CASE_RECENCY_HOURS=4.0

# ── Security / release readiness ─────────────────────────────────
# Staff accounts normally live in the `users` table and are managed from the
# "จัดการผู้ใช้" page. On first run the app seeds admin / admin1234 — change
# that password immediately from the sidebar account box -> เปลี่ยนรหัสผ่าน.
#
# This variable is only a break-glass fallback for accounts that are NOT in
# the database. Generate one entry with:
#   python scripts/make_password_hash.py admin Admin
# Then paste the output here. Multiple users are separated by semicolons.
SMARTVOICE_USERS=

# Calls stuck in "processing" for longer than this are reset to Pending when
# the app opens. Set 0 to disable.
PROCESSING_STALE_MINUTES=180

# ── Discord notifications ────────────────────────────────────────
# Posts to a Discord channel whenever someone claims, releases, closes or
# re-opens a case. Create it in Discord: channel settings -> Integrations ->
# Webhooks -> New Webhook -> Copy Webhook URL. Leave blank to send nothing.
# Treat it as a secret: anyone with the URL can post into the channel.
DISCORD_WEBHOOK_URL=
